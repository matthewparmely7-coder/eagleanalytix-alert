# Copy to .env and fill in. Do not commit .env.

# Existing EagleAnalytix Mongo (tm_events). Same value as backend MONGODB_URI.
SOURCE_MONGODB_URI=

# Local working set for this worker.
DATABASE_URL=mongodb://127.0.0.1:27017/eagleanalytix_alert

# History worker
TICK_MS=60000
BATCH_SIZE=8
S3_TIMEOUT_MS=2500
WATCHLIST_DAYS=21
HISTORY_LOOKBACK_DAYS=60

# Daily event list (local time in TIMEZONE)
TIMEZONE=America/New_York
DAILY_LIST_HOUR=0
DAILY_LIST_MINUTE=10

# S3 (same ticket history bucket the cron already writes)
AWS_ACCESS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_TICKETSHISTORY=tickets-history

# Pattern thresholds. Set COUNT/PRICE to 0 to ignore that check.
# If both percent and count/price are > 0, a hit must pass both.
SUPPLY_JUMP_PERCENT=30
SUPPLY_JUMP_COUNT=0
SUPPLY_HISTORY_DAYS=3
SUPPLY_ACTION_HOURS=6
ROCKET_JUMP_PERCENT=25
ROCKET_JUMP_PRICE=0
ROCKET_HISTORY_DAYS=10
ROCKET_ACTION_DAYS=3
ROCKET_QUIET_PERCENT=10
U_SHAPE_TROUGH_DAYS=5
U_SHAPE_DROP_DAYS=2
U_SHAPE_VARIATION_PERCENT=10
U_SHAPE_DIP_PERCENT=25
U_SHAPE_JUMP_PERCENT=25
U_SHAPE_JUMP_PRICE=0
U_SHAPE_ACTION_DAYS=3
U_SHAPE_MAX_HIGH_AGE_DAYS=3
U_SHAPE_MAX_RISE_DAYS=5

# Pattern 5: low resale + primary sells out
# History points now store { timestamp, primary, resale, minPrice } for TM.
THIN_TM_RESALE_MAX=150
THIN_VS_MAX=150
LOW_RESALE_LOOKBACK_DAYS=14
MIN_PRIMARY_DROP_PERCENT=25
STEEP_PRIMARY_DROP_PERCENT=40
PRIMARY_LOW_MAX=300
MIN_PRIMARY_SOLD=0
LOW_RESALE_JUMP_PERCENT=15
LOW_RESALE_JUMP_PRICE=0
LOW_RESALE_ACTION_DAYS=5
LOW_RESALE_QUIET_PERCENT=10
LOW_RESALE_HISTORY_DAYS=45

# Independent workers (all uses separate schedules in one process; npm start:<role> runs separately).
WORKER_ROLE=all
HISTORY_REFRESH_MS=300000
PATTERN_TICK_MS=30000
PATTERN_BATCH_SIZE=20
PATTERN_RECHECK_MS=900000

# Last Show Effect: stored concert series, not a price-qualified alert yet.
# New collections use DATABASE_URL, shared with the backend ALERT_MONGODB_URI.
SERIES_TICK_MS=300000
SERIES_GAP_DAYS=7
SERIES_CANDIDATE_DAYS=3
SERIES_REFRESH_MINUTES=60
SERIES_FULL_SCAN_HOURS=24

# Last Show Effect demand rules (initial thresholds; validate against historical examples)
LAST_SHOW_WINDOW_DAYS=7
LAST_SHOW_HOLD_HOURS=24
LAST_SHOW_MAX_GAP_HOURS=12
LAST_SHOW_MIN_POINTS=4
LAST_SHOW_INVENTORY_DROP_PERCENT=20
LAST_SHOW_HOLD_TOLERANCE_PERCENT=5
LAST_SHOW_COMPLETION_DELAY_HOURS=3
LAST_SHOW_POST_HOURS=6
LAST_SHOW_POST_DROP_PERCENT=10
LAST_SHOW_POST_PRICE_RISE_PERCENT=5
LAST_SHOW_COMPARISON_PRICE_FLOOR_PERCENT=90
LAST_SHOW_RECHECK_MS=900000
LAST_SHOW_BATCH_SIZE=10

# Later Tour Opportunity: inferred matching artist + tour title across cities
LATER_TOUR_EARLY_SHOWS=3
LATER_TOUR_MIN_EARLY_SHOWS=2
LATER_TOUR_CANDIDATE_DAYS=90
LATER_TOUR_GAP_DAYS=30
LATER_TOUR_WINDOW_DAYS=7
LATER_TOUR_HOLD_HOURS=24
LATER_TOUR_MAX_GAP_HOURS=12
LATER_TOUR_PRICE_RISE_PERCENT=5
LATER_TOUR_INVENTORY_DROP_PERCENT=10
LATER_TOUR_RECHECK_MS=900000
LATER_TOUR_BATCH_SIZE=5
LATER_TOUR_ACCELERATION_RATIO=1.2
