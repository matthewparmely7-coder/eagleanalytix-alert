# Copy to .env and fill in. Do not commit .env.

# Existing EagleAnalytix Mongo (tm_events). Same value as backend MONGODB_URI.
SOURCE_MONGODB_URI=

# Local working set for this worker.
DATABASE_URL=mongodb://127.0.0.1:27017/eagleanalytix_alert

# History worker
TICK_MS=60000
BATCH_SIZE=8
S3_TIMEOUT_MS=2500
WATCHLIST_DAYS=21
HISTORY_LOOKBACK_DAYS=60

# Daily event list (local time in TIMEZONE)
TIMEZONE=America/New_York
DAILY_LIST_HOUR=0
DAILY_LIST_MINUTE=10

# S3 (same ticket history bucket the cron already writes)
AWS_ACCESS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_TICKETSHISTORY=tickets-history

# Pattern thresholds. Set COUNT/PRICE to 0 to ignore that check.
# If both percent and count/price are > 0, a hit must pass both.
SUPPLY_JUMP_PERCENT=30
SUPPLY_JUMP_COUNT=0
SUPPLY_HISTORY_DAYS=3
SUPPLY_ACTION_HOURS=6
ROCKET_JUMP_PERCENT=25
ROCKET_JUMP_PRICE=0
ROCKET_HISTORY_DAYS=10
ROCKET_ACTION_DAYS=3
ROCKET_QUIET_PERCENT=10
U_SHAPE_TROUGH_DAYS=5
U_SHAPE_DROP_DAYS=2
U_SHAPE_VARIATION_PERCENT=10
U_SHAPE_DIP_PERCENT=25
U_SHAPE_JUMP_PERCENT=25
U_SHAPE_JUMP_PRICE=0
U_SHAPE_ACTION_DAYS=3
